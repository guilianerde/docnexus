{
  "name": "@rowansenne/docnexus",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guilianerde/docnexus.git"
  },
  "bugs": {
    "url": "https://github.com/guilianerde/docnexus/issues"
  },
  "homepage": "https://github.com/guilianerde/docnexus#readme",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist/src",
    "models",
    "skills",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "docnexus": "dist/src/cli.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/src/cli.js', 0o755)\"",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "mcp": "node dist/src/cli.js mcp"
  },
  "dependencies": {
    "@ladybugdb/core": "^0.16.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@huggingface/transformers": "^3.8.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
