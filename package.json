{
  "name": "@rowansenne/docnexus",
  "version": "0.26.1",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guilianerde/docnexus.git"
  },
  "bugs": {
    "url": "https://github.com/guilianerde/docnexus/issues"
  },
  "homepage": "https://github.com/guilianerde/docnexus#readme",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "dist/src",
    "!dist/src/**/*.map",
    "!dist/src/**/*.d.ts",
    "models",
    "viewer",
    "skills",
    "scripts/postinstall.mjs",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "docs",
    "!docs/operations/baselines"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "docnexus": "dist/src/cli.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/src/cli.js', 0o755)\"",
    "prepack": "npm run build",
    "postinstall": "node scripts/postinstall.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "eval:retrieval": "npm run build && node scripts/eval-retrieval.mjs",
    "eval:retrieval:quality": "npm run build && node scripts/eval-retrieval-quality.mjs",
    "eval:knowledge": "npm run build && node scripts/eval-knowledge.mjs",
    "eval:agent": "npm run build && node scripts/eval-agent.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.13",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-pgvector": "^0.0.11",
    "@huggingface/transformers": "^4.3.1",
    "markdown-it": "^15.0.3",
    "postgres": "^3.4.9"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
